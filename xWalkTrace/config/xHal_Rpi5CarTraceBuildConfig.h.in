#ifndef XHAL_RPI5CAR_TRACE_BUILD_CONFIG_H
#define XHAL_RPI5CAR_TRACE_BUILD_CONFIG_H

/******************************************************************************
 * Object-like macros
 ******************************************************************************/

/** @brief Build-local directory receiving xWalk trace records. */
#define XHAL_RPI5CAR_TRACE_LOG_DIRECTORY "@XWALK_TRACE_LOG_DIRECTORY@"

/** @brief Append-only xWalk trace filename. */
#define XHAL_RPI5CAR_TRACE_LOG_FILENAME "xWalkTrace.log"

#endif /* XHAL_RPI5CAR_TRACE_BUILD_CONFIG_H */
