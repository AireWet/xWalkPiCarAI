{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-host/cmake",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "/usr",
        "XWALK_BUILD_RPI": "OFF"
      }
    },
    {
      "name": "host-release",
      "inherits": "host-debug",
      "binaryDir": "${sourceDir}/build-host/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "sanity",
      "inherits": "host-debug",
      "binaryDir": "${sourceDir}/build-host/sanity",
      "cacheVariables": {
        "XWALK_ENABLE_STRICT_WARNINGS": "ON"
      }
    },
    {
      "name": "clang-tidy",
      "inherits": "host-debug",
      "binaryDir": "${sourceDir}/build-host/clang-tidy",
      "cacheVariables": {
        "CMAKE_CXX_CLANG_TIDY": "clang-tidy;--config-file=${sourceDir}/.clang-tidy",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "sanitizers",
      "inherits": "host-debug",
      "binaryDir": "${sourceDir}/build-host/sanitizers",
      "cacheVariables": {
        "XWALK_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "thread-sanitizer",
      "inherits": "host-debug",
      "binaryDir": "${sourceDir}/build-host/thread-sanitizer",
      "cacheVariables": {
        "XWALK_ENABLE_THREAD_SANITIZER": "ON"
      }
    },
    {
      "name": "coverage",
      "inherits": "host-debug",
      "binaryDir": "${sourceDir}/build-host/coverage",
      "cacheVariables": {
        "XWALK_ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "rpi-release",
      "inherits": "host-release",
      "binaryDir": "${sourceDir}/build-rpi/cmake",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "XWALK_BUILD_RPI": "ON",
        "XWALK_ENABLE_PACKAGING": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "host-debug", "configurePreset": "host-debug" },
    { "name": "host-release", "configurePreset": "host-release" },
    { "name": "sanity", "configurePreset": "sanity" },
    { "name": "clang-tidy", "configurePreset": "clang-tidy" },
    { "name": "sanitizers", "configurePreset": "sanitizers" },
    { "name": "thread-sanitizer", "configurePreset": "thread-sanitizer" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "rpi-release", "configurePreset": "rpi-release" }
  ],
  "testPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "host-release", "inherits": "host-debug", "configurePreset": "host-release" },
    { "name": "sanity", "inherits": "host-debug", "configurePreset": "sanity" },
    { "name": "sanitizers", "inherits": "host-debug", "configurePreset": "sanitizers" },
    {
      "name": "thread-sanitizer",
      "inherits": "host-debug",
      "configurePreset": "thread-sanitizer"
    },
    {
      "name": "host-stress",
      "inherits": "host-debug",
      "configurePreset": "sanity",
      "execution": {
        "noTestsAction": "error",
        "repeat": { "mode": "until-fail", "count": 20 }
      }
    },
    { "name": "coverage", "inherits": "host-debug", "configurePreset": "coverage" }
  ]
}
