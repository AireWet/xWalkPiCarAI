{
  "schema_version": 1,
  "repository": "MyPiCarX",
  "source_root": "xWalk-rpi5-hw",
  "components": [
    {
      "name": "Agent",
      "patterns": ["xWalk-rpi5-hw/xWalkDriver/**"]
    },
    {
      "name": "Audio Resources",
      "patterns": ["xWalk-rpi5-hw/xWalkAudioResources/**"]
    },
    {
      "name": "Controller",
      "patterns": ["xWalk-rpi5-hw/xWalkController/**"]
    },
    {
      "name": "HAL",
      "patterns": ["xWalk-rpi5-hw/xWalkHal/**"]
    },
    {
      "name": "Interface",
      "patterns": ["xWalk-rpi5-iw/**"]
    },
    {
      "name": "Library",
      "patterns": ["xWalk-rpi5-hw/xWalkLibrary/**"]
    },
    {
      "name": "Trace",
      "patterns": ["xWalk-rpi5-trace/**"]
    },
    {
      "name": "Developer Documentation",
      "patterns": ["devloper-note/**"]
    }
  ],
  "exclusions": [
    "build-host/**",
    "**/build/**",
    "**/build-*/**",
    "**/auto-gen/**",
    "**/generated/**",
    "**/Testing/**"
  ]
}
