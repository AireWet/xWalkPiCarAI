{
  "schema_version": 1,
  "repository": "MyPiCarX",
  "source_root": "xWalk-rpi5",
  "components": [
    {
      "name": "Agent",
      "patterns": ["xWalk-rpi5/xWalkAgent/**"]
    },
    {
      "name": "Audio Resources",
      "patterns": ["xWalk-rpi5/xWalkAudioResources/**"]
    },
    {
      "name": "Controller",
      "patterns": ["xWalk-rpi5/xWalkController/**"]
    },
    {
      "name": "HAL",
      "patterns": ["xWalk-rpi5/xWalkHal/**"]
    },
    {
      "name": "Interface",
      "patterns": ["xWalk-rpi5/xWalkIW/**"]
    },
    {
      "name": "Library",
      "patterns": ["xWalk-rpi5/xWalkLibrary/**"]
    },
    {
      "name": "Trace",
      "patterns": ["xWalk-rpi5/xWalkTrace/**"]
    },
    {
      "name": "Developer Documentation",
      "patterns": ["xWalk-rpi5/devloper-note/**"]
    }
  ],
  "exclusions": [
    "build-host/**",
    "**/build/**",
    "**/build-*/**",
    "**/auto-gen/**",
    "**/generated/**",
    "**/Testing/**"
  ]
}
