{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xwalk.local/schemas/guideline-review-report.schema.json",
  "title": "xWalk Guideline Review Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_id",
    "result",
    "reviewed_scope",
    "issues",
    "changed_files",
    "verification",
    "developer_actions"
  ],
  "properties": {
    "agent_id": {
      "const": "xwalk-guideline-reviewer"
    },
    "result": {
      "enum": [
        "passed",
        "passed-with-fixes",
        "developer-action-required",
        "blocked"
      ]
    },
    "reviewed_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verification"
      }
    },
    "developer_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/developerAction"
      }
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "rule",
        "file",
        "line",
        "evidence",
        "status",
        "resolution"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "rule": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "evidence": {
          "type": "string"
        },
        "status": {
          "enum": [
            "fixed",
            "blocked",
            "developer-action-required"
          ]
        },
        "resolution": {
          "type": "string"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "exit_code",
        "result"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "result": {
          "type": "string"
        }
      }
    },
    "developerAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error_message",
        "file_and_line",
        "guideline_rule",
        "evidence",
        "attempted_actions",
        "why_automatic_fix_is_unsafe",
        "requested_developer_decision"
      ],
      "properties": {
        "error_message": {
          "type": "string"
        },
        "file_and_line": {
          "type": "string"
        },
        "guideline_rule": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "attempted_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "why_automatic_fix_is_unsafe": {
          "type": "string"
        },
        "requested_developer_decision": {
          "type": "string"
        }
      }
    }
  }
}
