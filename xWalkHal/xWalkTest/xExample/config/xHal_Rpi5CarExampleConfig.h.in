#ifndef XHAL_RPI5CAR_EXAMPLE_CONFIG_H
#define XHAL_RPI5CAR_EXAMPLE_CONFIG_H

/******************************************************************************
 * Object-like macros
 ******************************************************************************/

/** @brief Build-local destination overwritten by each camera-chat capture. */
#define XHAL_RPI5CAR_EXAMPLE_IMAGE_PATH "@XWALK_EXAMPLE_IMAGE_OUTPUT_PATH@"

/** @brief Default YAML file supplying selector-specific formal arguments. */
#define XHAL_RPI5CAR_EXAMPLE_YAML_PATH \
    "@XWALK_EXAMPLE_CONFIG_OUTPUT_DIRECTORY@/xHal_Rpi5CarExampleConfig.yml"

/** @brief Deployment-selected native Ollama chat endpoint. */
#define XHAL_RPI5CAR_EXAMPLE_OLLAMA_ENDPOINT "@XWALK_EXAMPLE_OLLAMA_ENDPOINT@"

/** @brief Deployment-selected native Ollama endpoint for text-only chat. */
#define XHAL_RPI5CAR_EXAMPLE_OLLAMA_TEXT_ENDPOINT \
    "@XWALK_EXAMPLE_OLLAMA_TEXT_ENDPOINT@"

/** @brief Deployment-selected Qwen OpenAI-compatible chat endpoint. */
#define XHAL_RPI5CAR_EXAMPLE_QWEN_ENDPOINT \
    "@XWALK_EXAMPLE_QWEN_ENDPOINT@"

#endif /* XHAL_RPI5CAR_EXAMPLE_CONFIG_H */
