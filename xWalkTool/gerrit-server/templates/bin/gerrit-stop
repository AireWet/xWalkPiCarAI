#!/bin/sh
set -eu
# shellcheck source=/dev/null
. "$HOME/gerrit-env.sh"
case "$GERRIT_SITE" in "$HOME"/*) ;; *) echo "Unsafe GERRIT_SITE: $GERRIT_SITE" >&2; exit 2 ;; esac
[ -x "$GERRIT_SITE/bin/gerrit.sh" ] || { echo "Missing Gerrit control script" >&2; exit 2; }
exec "$GERRIT_SITE/bin/gerrit.sh" stop
