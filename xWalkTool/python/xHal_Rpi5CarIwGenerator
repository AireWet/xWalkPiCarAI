COMMAND_REQUEST_NAMES = tuple(
    message_name
    for message_name in TRANSACTION_REQUEST_NAMES
    if message_name.endswith("CommandRequest")
    and message_name != "XWalkControllerCommandRequest"
)
CONTROLLER_RPC_BINDINGS = tuple(
    (
        message_name.removeprefix("XWalk").removesuffix("CommandRequest"),
        message_name,
        message_name.replace("Request", "Cfm"),
