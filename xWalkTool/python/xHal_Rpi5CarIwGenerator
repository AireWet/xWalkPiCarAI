    "XWalkSensorType",
    "XWalkCalibrationMode",
)
ENUM_PATTERN = re.compile(r"^enum\s+(\w+)", re.MULTILINE)
MESSAGE_PATTERN = re.compile(r"^message\s+(\w+)", re.MULTILINE)
SERVICE_PATTERN = re.compile(r"^service\s+(\w+)", re.MULTILINE)
RPC_PATTERN = re.compile(r"^\s+rpc\s+(\w+)", re.MULTILINE)
CPP_SIGNAL_PATTERN = re.compile(
    r"^#define\s+(XWALK_CNTRL_[A-Z0-9_]+_REQ)\s+"
    r"\(::ctrl::uint16\{(0x[0-9A-F]+)U\}\)$",
    re.MULTILINE,
)
SIGNAL_NUMBER_PATTERN = re.compile(r"^0x[0-9A-F]{4}$")


def run_command(command: list[str]) -> None:
    """Run one generator command.

    Args:
        command: Executable and arguments passed without shell interpretation.

    Raises:
        subprocess.CalledProcessError: If the command returns a non-zero status.
    """
    print("running:", " ".join(command))
    subprocess.run(command, check=True)


def resolve_program(program: str, description: str) -> str:
    """Resolve one required executable.

    Args:
        program: Executable name or path supplied by the caller.
        description: Human-readable tool role used in diagnostics.

    Returns:
        Resolved executable path.

    Raises:
        ValueError: If the executable cannot be found.
    """
    resolved = shutil.which(program)
    if resolved is None:
        raise ValueError(f"{description} executable was not found: {program}")
    return resolved


def route_generated_cpp(
    staging_directory: pathlib.Path,
    include_directory: pathlib.Path,
    source_directory: pathlib.Path,
) -> None:
    """Route normalized generated C++ headers and sources by file type.

    Args:
        staging_directory: Temporary directory populated by protoc.
        include_directory: Destination for generated .h files.
        source_directory: Destination for generated .cpp files.

    Raises:
        OSError: If an output directory or generated file cannot be read or written.
    """
    include_directory.mkdir(parents=True, exist_ok=True)
    source_directory.mkdir(parents=True, exist_ok=True)
    for generated_path in staging_directory.iterdir():
        destination_path: pathlib.Path | None = None
        if generated_path.suffix == ".h":
            destination_path = include_directory / generated_path.name
        elif generated_path.suffix == ".cc":
            source_name = generated_path.with_suffix(".cpp").name
            destination_path = source_directory / source_name
        if destination_path is not None:
            generated_text = generated_path.read_text(encoding="utf-8")
            normalized_text = "\n".join(
                line.rstrip() for line in generated_text.splitlines()
            )
            destination_path.write_text(
                f"{normalized_text}\n", encoding="utf-8", newline="\n"
            )


def read_signal_xml(
    xml_path: pathlib.Path,
    expected_category: str,
) -> tuple[tuple[str, str, str], ...]:
    """Read and validate one XML signal registry.

    Args:
        xml_path: XML registry to read.
        expected_category: Required root category value.

    Returns:
        Ordered signal-name, number, and message tuples.

    Raises:
        OSError: If the registry cannot be read.
        ValueError: If the XML structure or attributes are invalid.
        element_tree.ParseError: If the registry is not well-formed XML.
    """
    root = element_tree.parse(xml_path).getroot()
    if root.tag != "xwalk-signals":
        raise ValueError(f"{xml_path.name} has an unexpected root element")
    if root.attrib != {"category": expected_category, "revision": "1"}:
        raise ValueError(f"{xml_path.name} has unexpected root attributes")

    entries: list[tuple[str, str, str]] = []
    for child in root:
        if child.tag != "signal":
            raise ValueError(f"{xml_path.name} contains an unexpected element")
        if set(child.attrib) != {"name", "number", "message"}:
            raise ValueError(f"{xml_path.name} contains invalid signal attributes")
        signal_name = child.attrib["name"]
        signal_number = child.attrib["number"]
        message_name = child.attrib["message"]
        if SIGNAL_NUMBER_PATTERN.fullmatch(signal_number) is None:
            raise ValueError(
                f"{xml_path.name} has an invalid signal number: {signal_number}"
            )
        entries.append((signal_name, signal_number, message_name))
    return tuple(entries)


def validate_schema_shape(
    schema_name: str,
    schema_text: str,
    expected_messages: tuple[str, ...],
) -> None:
    """Validate that one message schema contains only its expected messages.

    Args:
        schema_name: Filename used in diagnostics.
        schema_text: Complete Protobuf schema text.
        expected_messages: Required ordered message declaration names.

    Raises:
        ValueError: If the schema contains unexpected declarations.
    """
    enums = tuple(ENUM_PATTERN.findall(schema_text))
    messages = tuple(MESSAGE_PATTERN.findall(schema_text))
    services = tuple(SERVICE_PATTERN.findall(schema_text))
    rpcs = tuple(RPC_PATTERN.findall(schema_text))
    if enums:
        raise ValueError(f"{schema_name} contains unexpected enumerations: {enums}")
    if messages != expected_messages:
        raise ValueError(f"{schema_name} contains unexpected messages: {messages}")
    if services or rpcs:
        raise ValueError(f"{schema_name} must not declare services or RPCs")


def validate_signal_bindings(
    schema_text: str,
    entries: tuple[tuple[str, str, str], ...],
) -> None:
    """Validate that XML signal entries match message options.

    Args:
        schema_text: Schema containing the mapped messages.
        entries: XML signal-name, number, and message tuples.

    Raises:
        ValueError: If a message lacks its mapped signal option.
    """
    for _signal_name, signal_number, message_name in entries:
        message_pattern = re.compile(
            rf"message\s+{message_name}\s*\{{.*?"
            rf"option\s+\(xwalkSignal\)\s*=\s*{signal_number}\s*;",
            re.DOTALL,
        )
        if message_pattern.search(schema_text) is None:
            raise ValueError(
                f"Protobuf message {message_name} is not bound to {signal_number}"
            )


def validate_response_fields(
    schema_text: str,
    message_names: tuple[str, ...],
    final_fields: tuple[tuple[str, int], ...],
) -> None:
    """Validate the shared response fields in confirmation or rejection messages.

    Args:
        schema_text: Complete response schema.
        message_names: Ordered messages whose fields are checked.
        final_fields: Required field declaration text and tag number.

    Raises:
        ValueError: If a response message lacks a required field.
    """
    for message_name in message_names:
        match = re.search(
            rf"message\s+{message_name}\s*\{{(.*?)\n\}}",
            schema_text,
            re.DOTALL,
        )
        if match is None:
            raise ValueError(f"missing response message: {message_name}")
        message_body = match.group(1)
        required_fields = (
            ("bytes data", 1),
            ("bool responding", 2),
            *final_fields,
        )
        for declaration, tag in required_fields:
            if f"{declaration} = {tag};" not in message_body:
                raise ValueError(
                    f"{message_name} is missing field {declaration} = {tag}"
                )


def validate_inputs(
    enum_proto: pathlib.Path,
    request_proto: pathlib.Path,
    confirm_proto: pathlib.Path,
    reject_proto: pathlib.Path,
    service_proto: pathlib.Path,
    request_xml: pathlib.Path,
    confirm_xml: pathlib.Path,
    reject_xml: pathlib.Path,
    controller_command_header: pathlib.Path,
) -> None:
    """Validate the split message, service, XML, and C++ signal contracts.

    Args:
        enum_proto: Proto3 operation-enum schema.
        request_proto: Proto3 request-message schema.
        confirm_proto: Proto3 confirmation-message schema.
        reject_proto: Proto3 rejection-message schema.
        service_proto: Proto3 gRPC service schema.
        request_xml: Request signal registry.
        confirm_xml: Confirmation signal registry.
        reject_xml: Rejection signal registry.
        controller_command_header: C++ Controller command signal constants.

    Raises:
        OSError: If an input cannot be read.
        ValueError: If a schema or mapping is inconsistent.
        element_tree.ParseError: If an XML registry is malformed.
    """
    enum_text = enum_proto.read_text(encoding="utf-8")
    request_text = request_proto.read_text(encoding="utf-8")
    confirm_text = confirm_proto.read_text(encoding="utf-8")
    reject_text = reject_proto.read_text(encoding="utf-8")
    service_text = service_proto.read_text(encoding="utf-8")
    controller_command_text = controller_command_header.read_text(encoding="utf-8")

    enum_names = tuple(ENUM_PATTERN.findall(enum_text))
    if enum_names != ENUM_NAMES:
        raise ValueError(f"unexpected Protobuf enumerations: {enum_names}")
    if MESSAGE_PATTERN.findall(enum_text):
        raise ValueError("xHal_Rpi5CarXIwEnum.proto must contain only enumerations")

    validate_schema_shape(
        request_proto.name,
        request_text,
        REQUEST_MESSAGE_NAMES,
    )
    validate_schema_shape(
        confirm_proto.name,
        confirm_text,
        CONFIRM_MESSAGE_NAMES,
    )
    validate_schema_shape(
        reject_proto.name,
        reject_text,
        REJECT_MESSAGE_NAMES,
    )

    request_entries = read_signal_xml(request_xml, "req")
    confirm_entries = read_signal_xml(confirm_xml, "cfm")
    reject_entries = read_signal_xml(reject_xml, "rej")
    if tuple(entry[2] for entry in request_entries) != REQUEST_MESSAGE_NAMES:
        raise ValueError("unexpected request XML message mapping")
    if tuple(entry[2] for entry in confirm_entries) != CONFIRM_MESSAGE_NAMES:
        raise ValueError("unexpected confirmation XML message mapping")
    if tuple(entry[2] for entry in reject_entries) != REJECT_MESSAGE_NAMES:
        raise ValueError("unexpected rejection XML message mapping")

    all_entries = (*request_entries, *confirm_entries, *reject_entries)
    all_numbers = tuple(entry[1] for entry in all_entries)
    all_signal_names = tuple(entry[0] for entry in all_entries)
    if len(set(all_numbers)) != len(all_numbers):
        raise ValueError("duplicate xWalk signal numbers are configured")
    if len(set(all_signal_names)) != len(all_signal_names):
        raise ValueError("duplicate xWalk signal names are configured")

    validate_signal_bindings(request_text, request_entries)
    validate_signal_bindings(confirm_text, confirm_entries)
    validate_signal_bindings(reject_text, reject_entries)
    validate_response_fields(
        confirm_text,
        CONFIRM_MESSAGE_NAMES,
        (("bool flag", 3), ("string message", 4)),
    )
    validate_response_fields(
        reject_text,
        REJECT_MESSAGE_NAMES,
        (("uint32 reason", 3), ("string detail", 4)),
    )

    request_by_message = {entry[2]: entry for entry in request_entries}
    confirm_by_message = {entry[2]: entry for entry in confirm_entries}
    reject_by_message = {entry[2]: entry for entry in reject_entries}
    for request_name in TRANSACTION_REQUEST_NAMES:
        request_signal = request_by_message[request_name][0]
        confirm_name = request_name.replace("Request", "Cfm")
        reject_name = request_name.replace("Request", "Rej")
        expected_confirm_signal = request_signal.replace("_REQ", "_CFM")
        expected_reject_signal = request_signal.replace("_REQ", "_REJ")
        if confirm_by_message[confirm_name][0] != expected_confirm_signal:
            raise ValueError(f"unexpected confirmation signal for {confirm_name}")
        if reject_by_message[reject_name][0] != expected_reject_signal:
            raise ValueError(f"unexpected rejection signal for {reject_name}")

    cpp_signals = dict(CPP_SIGNAL_PATTERN.findall(controller_command_text))
    for signal_name, signal_number, _message_name in request_entries:
        if signal_name.startswith("XWALK_CNTRL_"):
            if cpp_signals.get(signal_name) != signal_number:
                raise ValueError(
                    f"C++ signal {signal_name} is not bound to {signal_number}"
                )

    grpc_services = tuple(SERVICE_PATTERN.findall(service_text))
    grpc_rpcs = tuple(RPC_PATTERN.findall(service_text))
    if MESSAGE_PATTERN.findall(service_text):
        raise ValueError("xHal_Rpi5CarXIwGrpc.proto must not declare messages")
    expected_services = tuple(binding[0] for binding in SERVICE_RPC_NAMES)
    if grpc_services != expected_services:
        raise ValueError(f"unexpected gRPC services: {grpc_services}")
    expected_rpcs = tuple(
        rpc_name
        for _service_name, rpc_names in SERVICE_RPC_NAMES
        for rpc_name in rpc_names
    )
    if grpc_rpcs != expected_rpcs:
        raise ValueError(f"unexpected gRPC methods: {grpc_rpcs}")
    for service_name, rpc_names in SERVICE_RPC_NAMES:
        service_match = re.search(
            rf"service\s+{service_name}\s*\{{(.*?)\n\}}",
            service_text,
            re.DOTALL,
        )
        if service_match is None:
            raise ValueError(f"missing gRPC service: {service_name}")
        actual_rpc_names = tuple(RPC_PATTERN.findall(service_match.group(1)))
        if actual_rpc_names != rpc_names:
            raise ValueError(f"unexpected RPCs in {service_name}: {actual_rpc_names}")
    execute_rpc = (
        "rpc Execute(XWalkI2cRequestPayload) returns (XWalkI2cCfmPayload);"
    )
    if execute_rpc not in service_text:
        raise ValueError("XWalkCtrlI2cService.Execute has unexpected message types")
    for rpc_name, request_name, confirm_name in CONTROLLER_RPC_BINDINGS:
        rpc_pattern = re.compile(
            rf"rpc\s+{rpc_name}\s*\(\s*{request_name}\s*\)\s*"
            rf"returns\s*\(\s*{confirm_name}\s*\)\s*;"
        )
        if rpc_pattern.search(service_text) is None:
            raise ValueError(
                f"Controller RPC {rpc_name} has unexpected message types"
            )

    required_imports = (
        'import "xHal_Rpi5CarXIwMessageReq.proto";',
        'import "xHal_Rpi5CarXIwMessageCfm.proto";',
    )
    if any(required_import not in service_text for required_import in required_imports):
        raise ValueError("xHal_Rpi5CarXIwGrpc.proto lacks a split message import")
    if 'import "xHal_Rpi5CarXIwEnum.proto";' not in request_text:
        raise ValueError("request schema must import xHal_Rpi5CarXIwEnum.proto")
    if 'import "xHal_Rpi5CarXIwMessageReq.proto";' not in confirm_text:
        raise ValueError("confirmation schema must import the request schema")
    if 'import "xHal_Rpi5CarXIwMessageReq.proto";' not in reject_text:
        raise ValueError("rejection schema must import the request schema")


def generate_grpc_cpp(
    enum_proto_path: pathlib.Path,
    request_proto_path: pathlib.Path,
    confirm_proto_path: pathlib.Path,
    reject_proto_path: pathlib.Path,
    service_proto_path: pathlib.Path,
    generated_directory: pathlib.Path,
    protoc_name: str,
    grpc_plugin_name: str,
    protobuf_include: pathlib.Path | None = None,
) -> None:
    """Generate and route C++ Protobuf and gRPC files.

    Args:
        enum_proto_path: Source operation-enum schema.
        request_proto_path: Source request-message schema.
        confirm_proto_path: Source confirmation-message schema.
        reject_proto_path: Source rejection-message schema.
        service_proto_path: Source gRPC service schema.
        generated_directory: Root containing include and src outputs.
        protoc_name: Protobuf compiler executable name or path.
        grpc_plugin_name: gRPC C++ generator executable name or path.
        protobuf_include: Optional directory containing imported Google schemas.

    Raises:
        OSError: If staging or output files cannot be written.
        ValueError: If a required generator executable cannot be resolved.
        subprocess.CalledProcessError: If Protobuf generation fails.
    """
    protoc = resolve_program(protoc_name, "Protobuf compiler")
    grpc_plugin = resolve_program(grpc_plugin_name, "gRPC C++ plugin")
    include_directory = generated_directory / "include"
    source_directory = generated_directory / "src"

    source_paths = (
        enum_proto_path,
        request_proto_path,
        confirm_proto_path,
        reject_proto_path,
        service_proto_path,
    )
    with tempfile.TemporaryDirectory(prefix="xwalk-iw-proto-") as staging_name:
        staging_directory = pathlib.Path(staging_name)
        staged_paths: list[pathlib.Path] = []
        for source_path in source_paths:
            staged_path = staging_directory / source_path.name
            shutil.copyfile(source_path.resolve(), staged_path)
            staged_paths.append(staged_path)

        base_command = [protoc, f"--proto_path={staging_directory}"]
        if protobuf_include is not None:
            base_command.append(f"--proto_path={protobuf_include.resolve()}")
        schema_command = [
            *base_command,
            f"--cpp_out={staging_directory}",
            *(str(path) for path in staged_paths[:-1]),
        ]
        service_command = [
            *base_command,
            f"--cpp_out={staging_directory}",
            f"--grpc_out={staging_directory}",
            f"--plugin=protoc-gen-grpc={grpc_plugin}",
            str(staged_paths[-1]),
        ]
        run_command(schema_command)
        run_command(service_command)
        route_generated_cpp(staging_directory, include_directory, source_directory)


def main() -> int:
    """Parse arguments and validate or generate the gRPC schema.

    Returns:
        Zero after successful validation or generation; otherwise one.
    """
    repository_directory = pathlib.Path(__file__).resolve().parents[2]
    component_directory = repository_directory / "xWalk-rpi5" / "xWalkIW"
    generated_directory = component_directory / "auto-gen"
    parser = argparse.ArgumentParser(
        description="Validate or generate the xWalkIW I2C and Controller schemas."
    )
    parser.add_argument(
        "--enum-proto",
        type=pathlib.Path,
        default=component_directory / "proto" / "xHal_Rpi5CarXIwEnum.proto",
    )
    parser.add_argument(
        "--request-proto",
        type=pathlib.Path,
        default=component_directory / "proto" / "xHal_Rpi5CarXIwMessageReq.proto",
    )
    parser.add_argument(
        "--confirm-proto",
        type=pathlib.Path,
        default=component_directory / "proto" / "xHal_Rpi5CarXIwMessageCfm.proto",
    )
    parser.add_argument(
        "--reject-proto",
        type=pathlib.Path,
        default=component_directory / "proto" / "xHal_Rpi5CarXIwMessageRej.proto",
    )
    parser.add_argument(
        "--service-proto",
        type=pathlib.Path,
        default=component_directory / "proto" / "xHal_Rpi5CarXIwGrpc.proto",
    )
    parser.add_argument(
        "--request-xml",
        type=pathlib.Path,
        default=component_directory / "config" / "xHal_Rpi5CarGrpcSigReq.xml",
    )
    parser.add_argument(
        "--confirm-xml",
        type=pathlib.Path,
        default=component_directory / "config" / "xHal_Rpi5CarGrpcSigCfm.xml",
    )
    parser.add_argument(
        "--reject-xml",
        type=pathlib.Path,
        default=component_directory / "config" / "xHal_Rpi5CarGrpcSigRej.xml",
    )
    parser.add_argument(
        "--controller-command-header",
        type=pathlib.Path,
        default=(
            repository_directory
            / "xWalk-rpi5"
            / "xWalkLibrary"
            / "common"
            / "include"
            / "xControllerCommand.h"
        ),
    )
    action_group = parser.add_mutually_exclusive_group(required=True)
    action_group.add_argument(
        "--check",
        action="store_true",
        help="validate the split proto and XML inputs without generating files",
    )
    action_group.add_argument(
        "--generate-cpp",
        "--genrate-cpp",
        dest="generate_cpp",
        action="store_true",
        help="validate inputs and generate the Protobuf and gRPC C++ files",
    )
    parser.add_argument("--protoc", default="protoc")
    parser.add_argument("--grpc-cpp-plugin", default="grpc_cpp_plugin")
    parser.add_argument(
        "--protobuf-include",
        type=pathlib.Path,
        default=pathlib.Path("/usr/include"),
    )
    parser.add_argument(
        "--generated-directory",
        type=pathlib.Path,
        default=generated_directory,
    )
    arguments = parser.parse_args()

    try:
        validate_inputs(
            arguments.enum_proto,
            arguments.request_proto,
            arguments.confirm_proto,
            arguments.reject_proto,
            arguments.service_proto,
            arguments.request_xml,
            arguments.confirm_xml,
            arguments.reject_xml,
            arguments.controller_command_header,
        )
        if arguments.generate_cpp:
            generate_grpc_cpp(
                arguments.enum_proto,
                arguments.request_proto,
                arguments.confirm_proto,
                arguments.reject_proto,
                arguments.service_proto,
                arguments.generated_directory.resolve(),
                arguments.protoc,
                arguments.grpc_cpp_plugin,
                arguments.protobuf_include,
            )
        else:
            print("validated split xWalkIW Protobuf and XML schemas")
    except (
        OSError,
        subprocess.CalledProcessError,
        ValueError,
        element_tree.ParseError,
    ) as error:
        print(f"xWalkIW generation failed: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
