#!/bin/sh
set -eu
# shellcheck source=/dev/null
. "$HOME/gerrit-env.sh"
case "$GERRIT_SITE" in "$HOME"/*) ;; *) echo "Unsafe GERRIT_SITE: $GERRIT_SITE" >&2; exit 2 ;; esac
config="$GERRIT_SITE/etc/gerrit.config"
[ -r "$config" ] || { echo "Missing Gerrit configuration" >&2; exit 2; }
auth_type="$(git config --file "$config" --get auth.type)"
[ "$auth_type" != "DEVELOPMENT_BECOME_ANY_ACCOUNT" ] || { echo "Unsafe development authentication is enabled" >&2; exit 1; }
web_url="$(git config --file "$config" --get gerrit.canonicalWebUrl)"
case "$web_url" in https://*) ;; *) echo "Canonical URL is not HTTPS: $web_url" >&2; exit 1 ;; esac
"$GERRIT_SITE/bin/gerrit.sh" status
pid_file="$GERRIT_SITE/logs/gerrit.pid"
[ -r "$pid_file" ] || { echo "Missing Gerrit PID file" >&2; exit 1; }
pid="$(cat "$pid_file")"
process_user="$(ps -o user= -p "$pid" | awk '{print $1}')"
[ "$process_user" = "$(id -un)" ] || { echo "Gerrit is running as unexpected user: $process_user" >&2; exit 1; }
trust_certificate="$GERRIT_SITE/etc/gerrit-ca.crt"
if [ ! -r "$trust_certificate" ]; then trust_certificate="$GERRIT_SITE/etc/gerrit-self-signed.crt"; fi
[ -r "$trust_certificate" ] || { echo "Missing TLS trust certificate" >&2; exit 1; }
if [ "$GERRIT_PROXY_MODE" = "local-http" ]; then
    http_status="$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' --cacert "$trust_certificate" "${web_url}config/server/version")"
    [ "$http_status" = "200" ] || { echo "Expected anonymous web access, received HTTP $http_status" >&2; exit 1; }
    git_http_status="$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' --cacert "$trust_certificate" "${web_url}public-check/info/refs?service=git-upload-pack")"
    [ "$git_http_status" = "401" ] || { echo "Expected Git-over-HTTP authentication, received HTTP $git_http_status" >&2; exit 1; }
else
    curl --fail --silent --show-error --cacert "$trust_certificate" "${web_url}config/server/version" >/dev/null
fi
"$JAVA_HOME/bin/java" -jar "$GERRIT_SITE/bin/gerrit.war" version
printf 'Authentication: %s\nCanonical URL: %s\nRepository root: %s\n' "$auth_type" "$web_url" "$GERRIT_SITE/git"
