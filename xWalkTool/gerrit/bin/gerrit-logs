#!/bin/sh
set -eu
# shellcheck source=/dev/null
. "$HOME/gerrit-env.sh"
case "$GERRIT_SITE" in "$HOME"/*) ;; *) echo "Unsafe GERRIT_SITE: $GERRIT_SITE" >&2; exit 2 ;; esac
[ -d "$GERRIT_SITE/logs" ] || { echo "Missing Gerrit log directory" >&2; exit 2; }
set -- "$GERRIT_SITE/logs/error_log" "$GERRIT_SITE/logs/httpd_log" "$GERRIT_SITE/logs/sshd_log"
if [ "$GERRIT_PROXY_MODE" = "local-http" ]; then
    set -- "$@" "$GERRIT_SITE/logs/caddy-runtime.log" "$GERRIT_SITE/logs/caddy-access.log"
fi
exec tail -n 100 -F "$@"
