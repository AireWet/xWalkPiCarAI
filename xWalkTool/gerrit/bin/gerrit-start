#!/bin/sh
set -eu
# shellcheck source=/dev/null
. "$HOME/gerrit-env.sh"
case "$GERRIT_SITE" in "$HOME"/*) ;; *) echo "Unsafe GERRIT_SITE: $GERRIT_SITE" >&2; exit 2 ;; esac
[ -x "$GERRIT_SITE/bin/gerrit.sh" ] || { echo "Missing Gerrit control script" >&2; exit 2; }
"$GERRIT_SITE/bin/gerrit.sh" start
if [ "$GERRIT_PROXY_MODE" = "local-http" ]; then
    if ! "$HOME/bin/gerrit-caddy-control" start; then
        "$GERRIT_SITE/bin/gerrit.sh" stop || true
        exit 1
    fi
fi
