#!/bin/sh
set -eu
# shellcheck source=/dev/null
. "$HOME/gerrit-env.sh"
"$HOME/bin/gerrit-site-check" >/dev/null
[ "$GERRIT_PROXY_MODE" = "local-http" ] || exit 0
[ "$#" -eq 1 ] || { echo "Usage: gerrit-caddy-control start|stop|status|reload" >&2; exit 2; }
[ -x "$CADDY_HOME/caddy" ] || { echo "Missing Caddy binary" >&2; exit 2; }
[ -r "$CADDY_CONFIG" ] || { echo "Missing Caddy configuration" >&2; exit 2; }
pid_file="$GERRIT_SITE/logs/caddy.pid"
unit="xwalk-gerrit-caddy.service"

validate_running_process()
{
    [ -r "$pid_file" ] || return 1
    pid="$(cat "$pid_file")"
    case "$pid" in *[!0-9]*|'') return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    process_state="$(ps -o stat= -p "$pid" | awk '{print $1}')"
    case "$process_state" in Z*) return 1 ;; esac
    expected_executable="$(readlink -f "$CADDY_HOME/caddy")"
    actual_executable="$(readlink -f "/proc/$pid/exe" 2>/dev/null || true)"
    [ "$actual_executable" = "$expected_executable" ] || {
        echo "Refusing to signal unexpected process from $pid_file" >&2
        return 2
    }
    process_user="$(ps -o user= -p "$pid" | awk '{print $1}')"
    [ "$process_user" = "$(id -un)" ] || {
        echo "Refusing to signal Caddy owned by $process_user" >&2
        return 2
    }
    return 0
}

wait_for_start()
{
    attempts=0
    while ! validate_running_process && [ "$attempts" -lt 10 ]; do
        sleep 1
        attempts=$((attempts + 1))
    done
    validate_running_process || return 1
}

launch_proxy()
{
    if [ "${GERRIT_PROCESS_MANAGER:-nohup}" = "systemd" ]; then
        systemd-run --user --unit "$unit" --collect --no-block \
            "$CADDY_HOME/caddy" run --config "$CADDY_CONFIG" \
            --adapter caddyfile --pidfile "$pid_file"
    else
        nohup "$CADDY_HOME/caddy" run --config "$CADDY_CONFIG" \
            --adapter caddyfile --pidfile "$pid_file" \
            >> "$GERRIT_SITE/logs/caddy-bootstrap.log" 2>&1 &
    fi
}

start_proxy()
{
    if validate_running_process; then
        printf 'Caddy HTTPS proxy already running (PID %s)\n' "$pid"
        return 0
    else
        status=$?
    fi
    [ "$status" -ne 2 ] || return 2
    rm -f "$pid_file"
    "$CADDY_HOME/caddy" validate --config "$CADDY_CONFIG"
    launch_proxy
    wait_for_start || {
        echo "Caddy did not start within 10 seconds" >&2
        tail -n 20 "$GERRIT_SITE/logs/caddy-bootstrap.log" >&2 || true
        return 1
    }
    printf 'Caddy HTTPS proxy started (PID %s)\n' "$pid"
}

wait_for_stop()
{
    attempts=0
    while kill -0 "$pid" 2>/dev/null && [ "$attempts" -lt 10 ]; do
        process_state="$(ps -o stat= -p "$pid" | awk '{print $1}')"
        case "$process_state" in Z*) return 0 ;; esac
        sleep 1
        attempts=$((attempts + 1))
    done
    ! kill -0 "$pid" 2>/dev/null
}

stop_proxy()
{
    if validate_running_process; then
        status=0
    else
        status=$?
        [ "$status" -ne 2 ] || return 2
        echo "Caddy HTTPS proxy is not running"
        return 0
    fi
    if [ "${GERRIT_PROCESS_MANAGER:-nohup}" = "systemd" ]; then
        systemctl --user stop "$unit"
    else
        kill -TERM "$pid"
    fi
    wait_for_stop || { echo "Caddy did not stop within 10 seconds" >&2; return 1; }
    rm -f "$pid_file"
    echo "Caddy HTTPS proxy stopped"
}

status_proxy()
{
    validate_running_process
    printf 'Caddy HTTPS proxy: RUNNING (PID %s)\n' "$pid"
}

reload_proxy()
{
    "$CADDY_HOME/caddy" validate --config "$CADDY_CONFIG"
    stop_proxy
    start_proxy
    echo "Caddy HTTPS proxy configuration restarted"
}

case "$1" in
    start) start_proxy ;;
    stop) stop_proxy ;;
    status) status_proxy ;;
    reload) reload_proxy ;;
    *) echo "Usage: gerrit-caddy-control start|stop|status|reload" >&2; exit 2 ;;
esac
