#!/bin/sh
set -eu
umask 077
# shellcheck source=/dev/null
. "$HOME/gerrit-env.sh"
case "$GERRIT_SITE" in "$HOME"/*) ;; *) echo "Unsafe GERRIT_SITE: $GERRIT_SITE" >&2; exit 2 ;; esac
backup_root="$HOME/backups/gerrit"
case "$backup_root" in "$HOME"/*) ;; *) echo "Unsafe backup root" >&2; exit 2 ;; esac
mkdir -p "$backup_root"
available_kib="$(df -Pk "$backup_root" | awk 'NR == 2 {print $4}')"
set -- "$GERRIT_SITE/git" "$GERRIT_SITE/etc" "$GERRIT_SITE/data" "$GERRIT_SITE/index" "$GERRIT_SITE/plugins" "$HOME/apps/gerrit"
if [ "$GERRIT_PROXY_MODE" = "local-http" ]; then set -- "$@" "$HOME/apps/caddy" "$HOME/gerrit-proxy"; fi
if [ -e "$HOME/gerrit-ci" ]; then set -- "$@" "$HOME/gerrit-ci"; fi
required_kib="$(du -sk "$@" 2>/dev/null | awk '{sum += $1} END {print sum * 2}')"
[ "$available_kib" -gt "$required_kib" ] || { echo "Insufficient free space for a conservative backup" >&2; exit 1; }
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
archive="$backup_root/gerrit-$timestamp.tar.gz"
[ ! -e "$archive" ] || { echo "Backup already exists: $archive" >&2; exit 1; }
was_running=false
if "$GERRIT_SITE/bin/gerrit.sh" status >/dev/null 2>&1; then was_running=true; fi
if [ "$GERRIT_PROXY_MODE" = "local-http" ] && "$HOME/bin/gerrit-caddy-control" status >/dev/null 2>&1; then
    was_running=true
fi
was_ci_running=false
if [ -r "$HOME/.xwalk-ci.env" ] && "$HOME/bin/gerrit-ci-control" status >/dev/null 2>&1; then
    was_ci_running=true
    "$HOME/bin/gerrit-ci-control" stop
fi
if [ "$was_running" = true ]; then
    "$HOME/bin/gerrit-stop"
fi
restart_if_needed()
{
    if [ "$was_running" = true ]; then "$HOME/bin/gerrit-start"; fi
    if [ "$was_ci_running" = true ]; then "$HOME/bin/gerrit-ci-control" start; fi
}
trap restart_if_needed EXIT
trap 'exit 130' HUP INT TERM
set -- gerrit-site/git gerrit-site/etc gerrit-site/data gerrit-site/index gerrit-site/plugins apps/gerrit gerrit-env.sh
if [ -e "$HOME/gerrit-site/db" ]; then set -- "$@" gerrit-site/db; fi
if [ "$GERRIT_PROXY_MODE" = "local-http" ]; then set -- "$@" apps/caddy gerrit-proxy; fi
if [ -e "$HOME/gerrit-ci" ]; then set -- "$@" gerrit-ci; fi
tar -C "$HOME" -czf "$archive" "$@"
tar -tzf "$archive" >/dev/null
sha256sum "$archive" > "$archive.sha256"
tar -tzf "$archive" | sed -n '1,40p'
ls -lh "$archive" "$archive.sha256"
cat "$archive.sha256"
