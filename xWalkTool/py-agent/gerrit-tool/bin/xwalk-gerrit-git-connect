#!/usr/bin/env bash
set -Eeuo pipefail

usage()
{
    printf 'Usage: xwalk-gerrit-git-connect USER_AT_HOST PORT PROJECT AUTO_START SERVICE\n' >&2
}

if [[ $# -ne 5 ]]
then
    usage
    exit 2
fi

remote_host=$1
remote_port=$2
project_name=$3
auto_start=$4
service_name=$5

[[ "${remote_host}" =~ ^[A-Za-z0-9._-]+@[A-Za-z0-9.-]+$ ]] || {
    printf 'Invalid Gerrit SSH host: %s\n' "${remote_host}" >&2
    exit 2
}
[[ "${remote_port}" =~ ^[0-9]+$ ]] || {
    printf 'Invalid Gerrit SSH port: %s\n' "${remote_port}" >&2
    exit 2
}
[[ "${project_name}" =~ ^[A-Za-z0-9._/-]+$ ]] || {
    printf 'Invalid Gerrit project: %s\n' "${project_name}" >&2
    exit 2
}
[[ "${auto_start}" == true || "${auto_start}" == false ]] || {
    printf 'AUTO_START must be true or false.\n' >&2
    exit 2
}
[[ "${service_name}" == git-receive-pack ]] || {
    printf 'Unsupported Gerrit Git service: %s\n' "${service_name}" >&2
    exit 2
}

start_command="${HOME}/bin/gerrit-start"
if [[ "${auto_start}" == true && -x "${start_command}" ]]
then
    "${start_command}" >&2
fi

ssh_command=${XWALK_GIT_SSH_BIN:-ssh}
exec "${ssh_command}" -p "${remote_port}" "${remote_host}" "${service_name} '${project_name}'"
