#!/bin/sh
set -eu

# shellcheck source=/dev/null
. "$HOME/gerrit-env.sh"

case "$GERRIT_SITE" in
    /*) ;;
    *) echo "GERRIT_SITE is not absolute: $GERRIT_SITE" >&2; exit 2 ;;
esac
case "$GERRIT_SITE" in
    /|/home|/mnt|/media|/opt|/srv|/tmp|/usr|/var|"$HOME")
        echo "Unsafe broad GERRIT_SITE: $GERRIT_SITE" >&2
        exit 2
        ;;
esac
[ -d "$GERRIT_SITE" ] || { echo "Missing Gerrit site: $GERRIT_SITE" >&2; exit 2; }
resolved="$(readlink -f -- "$GERRIT_SITE")"
[ "$resolved" = "$GERRIT_SITE" ] || {
    echo "GERRIT_SITE is not its resolved non-symbolic path: $GERRIT_SITE" >&2
    exit 2
}
owner="$(stat -c %u -- "$GERRIT_SITE")"
[ "$owner" = "$(id -u)" ] || {
    echo "GERRIT_SITE is owned by unexpected user ID $owner" >&2
    exit 2
}
printf '%s\n' "$GERRIT_SITE"
