#!/bin/sh
set -eu
# shellcheck source=/dev/null
. "$HOME/gerrit-env.sh"
"$HOME/bin/gerrit-site-check" >/dev/null
[ -x "$GERRIT_SITE/bin/gerrit.sh" ] || { echo "Missing Gerrit control script" >&2; exit 2; }
status=0
if [ -r "$HOME/.xwalk-ci.env" ]; then
    if [ -x "$HOME/bin/gerrit-ci-control" ]; then
        "$HOME/bin/gerrit-ci-control" stop || status=$?
    else
        echo "Missing installed Gerrit CI control command" >&2
        status=2
    fi
fi
if [ "$GERRIT_PROXY_MODE" = "local-http" ]; then
    "$HOME/bin/gerrit-caddy-control" stop || status=$?
fi
"$GERRIT_SITE/bin/gerrit.sh" stop || status=$?
exit "$status"
