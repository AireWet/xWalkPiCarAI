#!/usr/bin/env bash
set -eu
umask 077
# shellcheck source=/dev/null
. "$HOME/gerrit-env.sh"
[ "$GERRIT_PROXY_MODE" = "local-http" ] || { echo "Local user management is not enabled" >&2; exit 2; }
[ "$#" -eq 1 ] || { echo "Usage: gerrit-user-add USERNAME" >&2; exit 2; }
username="$1"
case "$username" in *[!A-Za-z0-9._-]*|'') echo "Unsafe username: $username" >&2; exit 2 ;; esac
case "$username" in [A-Za-z0-9]*) ;; *) echo "Username must start with a letter or digit" >&2; exit 2 ;; esac
[ "${#username}" -le 64 ] || { echo "Username is too long" >&2; exit 2; }
users_file="$HOME/gerrit-proxy/users.caddy"
[ -r "$users_file" ] || { echo "Missing local user file" >&2; exit 2; }
if awk -v user="$username" '$1 == user { found = 1 } END { exit !found }' "$users_file"; then
    echo "User already exists: $username" >&2
    exit 1
fi
read -r -s -p "Enter a unique password of at least 12 characters for $username: " password
printf '\n'
[ "${#password}" -ge 12 ] || { unset password; echo "Password must contain at least 12 characters" >&2; exit 1; }
read -r -s -p "Confirm the password: " confirmation
printf '\n'
[ "$password" = "$confirmation" ] || { unset password confirmation; echo "Passwords do not match" >&2; exit 1; }
unset confirmation
password_hash="$(printf '%s\n' "$password" | "$CADDY_HOME/caddy" hash-password --algorithm bcrypt)"
unset password
case "$password_hash" in \$2a\$*|\$2b\$*|\$2y\$*) ;; *) echo "Caddy returned an invalid password hash" >&2; exit 1 ;; esac
backup="$(mktemp "$HOME/gerrit-proxy/users.caddy.backup.XXXXXX")"
cp "$users_file" "$backup"
printf '%s %s\n' "$username" "$password_hash" >> "$users_file"
chmod 600 "$users_file"
if ! "$HOME/bin/gerrit-caddy-control" reload; then
    mv "$backup" "$users_file"
    "$HOME/bin/gerrit-caddy-control" reload || true
    echo "Caddy reload failed; the user file was restored" >&2
    exit 1
fi
rm -f "$backup"
printf 'Local web login enabled for %s. The user must sign in once, then add an individual SSH public key.\n' "$username"
