#!/bin/sh
set -eu
environment_file="$HOME/.xwalk-ci.env"
if [ -r "$environment_file" ]; then
    set -a
    # shellcheck source=/dev/null
    . "$environment_file"
    set +a
fi
log_directory="${XWALK_CI_LOG_DIRECTORY:-$HOME/gerrit-ci/logs}"
case "$log_directory" in "$HOME"/*) ;; *) echo "Unsafe CI log directory: $log_directory" >&2; exit 2 ;; esac
mkdir -p "$log_directory"
touch "$log_directory/service.log"
tail -n 200 -f "$log_directory/service.log"
