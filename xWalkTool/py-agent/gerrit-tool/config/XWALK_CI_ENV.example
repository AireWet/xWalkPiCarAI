# Copy to @@HOME@@/.xwalk-ci.env, replace key paths if needed, and retain mode 0600.
GERRIT_HOST=@@SERVER_IP@@
GERRIT_SERVER_HOST=@@SERVER_IP@@
GERRIT_SSH_PORT=@@SSH_PORT@@
GERRIT_USER=xwalk-ci
GERRIT_CI_USERNAME=xwalk-ci
GERRIT_ADMIN_USERNAME=@@ADMIN_USERNAME@@
GERRIT_PROJECT=@@PROJECT_NAME@@
GERRIT_BRANCH=@@PROJECT_BRANCH@@
GERRIT_VERIFICATION_TARGETS=@@PROJECT_NAME@@:@@PROJECT_BRANCH@@
GERRIT_SSH_KEY=@@HOME@@/.ssh/id_ed25519_xwalk_ci
GERRIT_UPLIFT_ENABLED=false
GERRIT_UPLIFT_SCRIPT=@@GERRIT_SITE@@/gerrit-tools/shell-script/gerrit-auto-uplift.sh
XWALK_GERRIT_MULTI_REPO_CONFIG=@@GERRIT_SITE@@/gerrit-tools/config/multi-repo.conf
GITHUB_SYNC_SOURCE_PROJECT=@@PROJECT_NAME@@
GITHUB_SYNC_SOURCE_BRANCH=@@PROJECT_BRANCH@@
GITHUB_INTEGRATION_REMOTE=
GITHUB_INTEGRATION_WEB_URL=
GITHUB_INTEGRATION_BRANCH=@@PROJECT_BRANCH@@
GITHUB_PUSH_ENABLED=false
GITHUB_DIRECT_PUSH_OWNER_EMAIL=
GITHUB_SSH_KEY=@@HOME@@/.ssh/id_ed25519_xwalk_github_mirror
XWALK_CI_STATE_DIRECTORY=@@HOME@@/gerrit-ci/state
XWALK_CI_LOG_DIRECTORY=@@HOME@@/gerrit-ci/logs
XWALK_CI_LOG_HTTP_HOST=127.0.0.1
XWALK_CI_LOG_HTTP_PORT=8091
XWALK_CI_LOG_WEB_URL=https://@@SERVER_IP@@:@@HTTPS_PORT@@/ci
XWALK_CI_MAX_WORKERS=4
XWALK_CODESCENE_CLI=@@HOME@@/.local/bin/cs
XWALK_CODESCENE_STRICT=false
XWALK_CODESCENE_TIMEOUT_SECONDS=900
CS_ACCESS_TOKEN=
CS_ONPREM_URL=
XWALK_CADDY_TEST_BINARY=
XWALK_CADDY_TEST_ARCHIVE=
